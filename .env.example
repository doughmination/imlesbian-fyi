# Copy to .env at the repo root before running `docker compose up`.
# Anything without a default in compose.yml is required (compose will
# refuse to start without it).

POSTGRES_HOST=db
POSTGRES_USER=imlesbian
POSTGRES_PASSWORD=changeme_use_a_real_password
POSTGRES_DB=imlesbian_fyi

# Generate with: openssl rand -base64 48
SESSION_SECRET=changeme_generate_a_real_32plus_char_secret

FRONTEND_ORIGIN=https://imlesbian.fyi
FRONTEND_DASHBOARD_URL=https://imlesbian.fyi/dashboard
NEXT_PUBLIC_API_URL=https://api.imlesbian.fyi

# Discord app: https://discord.com/developers/applications
# Redirect URI must match exactly what's registered there.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://api.imlesbian.fyi/auth/discord/callback